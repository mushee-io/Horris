# Public web configuration
NEXT_PUBLIC_HORRIS_VAULT=
NEXT_PUBLIC_HORRIS_MENTO_ADAPTER=
NEXT_PUBLIC_HORRIS_DEPLOYMENT_BLOCK=
# Disabled by default. Set true only for an explicit local/testnet wallet-direct demo.
NEXT_PUBLIC_ALLOW_WALLET_DIRECT_DEMO=false

# Discord interaction endpoint
# Keep the bot token private. The public key is safe to expose server-side but is not needed by the browser.
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Foundry deployment configuration
# Never commit a real private key.
DEPLOYER_PRIVATE_KEY=
HORRIS_AGENT=
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# UpDown / perp guard configuration (Celo mainnet)
# HORRIS_PERP_AUTHORIZER is the dedicated, rotatable EIP-712 signer.
# HORRIS_PERP_OWNER should be the intended long-term admin/multisig. Deployment only proposes ownership; the recipient must accept it onchain.
HORRIS_PERP_AUTHORIZER=
HORRIS_PERP_OWNER=
HORRIS_PERP_POLICY=
HORRIS_UPDOWN_GUARD=
HORRIS_UPDOWN_AUTHORIZATION=
CELO_MAINNET_RPC_URL=https://forno.celo.org
