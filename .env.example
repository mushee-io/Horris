# Horris uses the pinned real Celo Sepolia MVP deployment by default.
# Set these only to intentionally override the public deployment addresses.
NEXT_PUBLIC_HORRIS_VAULT=0xEd97E9c79599CFB671D59063F8aE446b9C5e0497
NEXT_PUBLIC_HORRIS_MENTO_ADAPTER=0xbf1abbE40d9B4Fea970Cf9E2b397109eC1D06CEc
NEXT_PUBLIC_HORRIS_DEPLOYMENT_BLOCK=
# Disabled by default. Never enable for production/demo unless explicitly reviewing wallet-direct testnet behavior.
NEXT_PUBLIC_ALLOW_WALLET_DIRECT_DEMO=false

# Horris AI — server-side only. This is the only required secret for the first Vercel smoke deployment.
# Never expose GROQ_API_KEY through NEXT_PUBLIC_*, source control, logs, screenshots, or chat.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Discord — optional. Configure only if the Discord interaction endpoint is being enabled.
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# LOCAL FOUNDRY DEPLOYMENT ONLY — DO NOT SET PRIVATE KEYS IN VERCEL.
# Never commit a real private key.
DEPLOYER_PRIVATE_KEY=
HORRIS_AGENT=
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# UpDown / perp guard configuration (Celo mainnet review-only)
# No genuine UpDown Celo Sepolia deployment is configured in Horris.
# Signing/broadcast remains disabled until a reviewed mainnet custody path is explicitly enabled.
HORRIS_PERP_AUTHORIZER=
HORRIS_PERP_OWNER=
HORRIS_PERP_POLICY=
HORRIS_UPDOWN_GUARD=
HORRIS_UPDOWN_AUTHORIZATION=
CELO_MAINNET_RPC_URL=https://forno.celo.org
